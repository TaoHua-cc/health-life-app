{"food":{"陕西":{"西安":{"top":[{"r":1,"n":"牛羊肉泡馍","c":"主食","d":"西安灵魂小吃，讲究手掰\"黄豆粒\"大小，煮馍分干拔/口汤/水围城，汤浓馍筋、肉烂味厚。","s":"老米家牛羊肉泡馍/老孙家泡馍","p":"￥30-45","must":"优质牛肉泡馍配糖蒜","area":"回民街·北院门"},{"r":2,"n":"腊汁肉夹馍","c":"小吃","d":"白吉馍现打现烤，腊汁肉瘦而不柴、肥而不腻，趁热咬下汤汁四溢。","s":"樊记肉夹馍/子午路张记肉夹馍","p":"￥12-18","must":"普通腊汁肉夹馍","area":"竹笆市/子午路"},{"r":3,"n":"Biangbiang面","c":"面食","d":"裤带面宽如裤带，一勺热油泼在辣子上滋啦作响，一根管饱、筋道弹牙。","s":"老李家肉丸糊辣汤/三根电杆擀面皮","p":"￥18-28","must":"油泼biangbiang面","area":"南院门"},{"r":4,"n":"凉皮(麻酱)","c":"小吃","d":"筋道透亮，麻酱醇香或油泼辣子开胃，夏天消暑第一味，配冰峰更地道。","s":"魏家凉皮","p":"￥10-14","must":"麻酱凉皮+冰峰","area":"全城"},{"r":5,"n":"葫芦头泡馍","c":"主食","d":"猪大肠泡馍，汤白味厚、肠烂不腥，配泡菜解腻，是老饕专属。","s":"春发生","p":"￥35-50","must":"葫芦头+发丝百叶","area":"南院门"},{"r":6,"n":"臊子面","c":"面食","d":"酸辣香薄筋光煎稀汪，一碗七味俱全，红油浮面、臊子鲜香。","s":"永明岐山面/岐山臊子面","p":"￥16-22","must":"酸汤臊子面","area":"西大街"},{"r":7,"n":"肉丸胡辣汤","c":"早餐","d":"牛肉丸+十余种蔬菜勾芡，辛香暖胃，配坨坨馍掰入吸汤最香。","s":"马老四肉丁胡辣汤/小皮院","p":"￥12-16","must":"胡辣汤+坨坨馍","area":"小皮院"},{"r":8,"n":"灌汤包子","c":"小吃","d":"皮薄汤满，提笼轻晃先喝汤，牛羊肉鲜美、馅大汁多。","s":"贾三灌汤包子(北院门)","p":"￥20-30","must":"牛肉灌汤包","area":"北院门"},{"r":9,"n":"甑糕","c":"甜点","d":"糯米红枣芸豆层层蒸透，枣香绵甜，早起一盒当早饭最满足。","s":"东南亚甄糕","p":"￥8-12","must":"红枣甑糕","area":"西羊市"},{"r":10,"n":"水盆羊肉","c":"硬菜","d":"清汤羊肉片，汤清肉烂无膻，配月牙饼夹肉，秋冬季最宜。","s":"老白家腊牛羊肉/铁志明腊牛肉","p":"￥40-60","must":"澄城水盆羊肉","area":"碑林/澄城"},{"r":11,"n":"烤羊肉串","c":"硬菜","d":"孜然辣面一撒，炭火滋滋，肥瘦相间最香，回坊夜市灵魂。","s":"马乐烤肉(红埠街)","p":"￥3-5/串","must":"红柳枝烤羊肉","area":"红埠街"},{"r":12,"n":"粉蒸肉(回民)","c":"主食","d":"牛肉裹米蒸透，油润软糯，夹馍或单吃都香。","s":"定家小酥肉(大皮院)","p":"￥18-25","must":"牛肉粉蒸肉","area":"大皮院"},{"r":13,"n":"醪糟鸡蛋","c":"甜点","d":"糯米酒酿煮蛋花，温润微醺，冬夜暖身、夏日冰镇皆宜。","s":"老白家醪糟(回坊)","p":"￥6-10","must":"桂花醪糟蛋","area":"回坊"},{"r":14,"n":"柿子糊塌","c":"甜点","d":"临潼火晶柿子碾泥裹面炸，外脆里糯、清甜不腻，秋冬季限定。","s":"临潼火晶柿子糊塌(临潼)","p":"￥8-12","must":"火晶柿子糊塌","area":"临潼"},{"r":15,"n":"稠酒","c":"饮品","d":"黄桂稠酒米香低度，温饮醇厚，仿唐风雅，配硬菜解腻。","s":"黄桂稠酒(西安饭庄)","p":"￥15-25","must":"黄桂稠酒","area":"东大街"},{"r":16,"n":"金线油塔","c":"小吃","d":"面丝盘绕如塔，蒸后抖散凉拌，葱油咸香、入口即化。","s":"伊古斋(回坊)","p":"￥10-15","must":"葱油金线油塔","area"